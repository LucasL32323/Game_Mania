# =============================================================================
# GameMania 2.0 — copie para .env e preencha. NUNCA versione o .env.
# Gerar chave de 32 bytes:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# =============================================================================
GM_ENVIRONMENT=development
GM_SERVE_FRONTEND=true
GM_FRONTEND_DIR=../frontend

GM_DATABASE_URL=postgresql+asyncpg://gamemania_app:TROQUE_AQUI@localhost:5432/gamemania
GM_ANALYTICS_DATABASE_URL=postgresql+asyncpg://gamemania_analytics:TROQUE_AQUI@localhost:5432/gamemania

# AES-256-GCM: mapa {id: chave}. Para rotacionar, adicione {"2": "..."} e mude o ID ativo.
GM_EMAIL_AES_KEYS={"1": "COLE_AQUI_BASE64_32_BYTES"}
GM_EMAIL_AES_ACTIVE_KEY_ID=1
GM_EMAIL_HMAC_KEY=COLE_AQUI_BASE64_32_BYTES
GM_IP_HMAC_KEY=COLE_AQUI_BASE64_32_BYTES
GM_JWT_SECRET=COLE_AQUI_UM_SEGREDO_LONGO

# Em dev (HTTP) precisa ser false; em produção (HTTPS) true → cookies __Host-
GM_COOKIE_SECURE=false
GM_ALLOWED_ORIGINS=["http://localhost:8000"]
GM_ALLOWED_HOSTS=["localhost","127.0.0.1"]
